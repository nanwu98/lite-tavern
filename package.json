{
  "name": "lite-tavern",
  "version": "1.7.0",
  "private": true,
  "description": "A minimal local client for SillyTavern character cards and world books",
  "author": "LiteTavern contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.28.5",
  "homepage": "https://github.com/nanwu98/lite-tavern#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanwu98/lite-tavern.git"
  },
  "bugs": {
    "url": "https://github.com/nanwu98/lite-tavern/issues"
  },
  "keywords": [
    "sillytavern",
    "character-card",
    "worldbook",
    "llm",
    "openai-compatible",
    "electron",
    "capacitor"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron:start": "electron .",
    "electron:pack": "npm run build && electron-builder --dir --win --x64",
    "windows:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "release:manifest": "node scripts/make-version-manifest.mjs"
  },
  "dependencies": {
    "@capacitor/core": "6.2.3",
    "@capacitor/filesystem": "6.0.2",
    "@capacitor/share": "6.0.3",
    "dompurify": "^3.2.6",
    "idb-keyval": "^6.2.2",
    "marked": "^16.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/cli": "6.2.3",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
